{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Local Server",
      "type": "shell",
      "command": "node",
      "args": ["${workspaceFolder}\\server.js"],
      "isBackground": true,
      "problemMatcher": [
        {
          "owner": "custom",
          "fileLocation": ["relative", "${workspaceFolder}"],
          "pattern": {
            "regexp": "^Local server running at http://localhost:(\\d+)$"
          },
          "background": {
            "beginsPattern": ".*",
            "endsPattern": "^Local server running at http://localhost:(\\d+)$"
          }
        }
      ],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated"
      }
    }
  ]
}
